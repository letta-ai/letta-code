#!/usr/bin/env sh

STAGED_TS=$(git diff --cached --name-only | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS" ]; then
  VIOLATIONS=$(echo "$STAGED_TS" | xargs grep -lE '^(import|export).*from "\.\.' 2>/dev/null | xargs grep -E '^(import|export).*from "\.\.' 2>/dev/null | grep -v 'package\.json' || true)
  if [ -n "$VIOLATIONS" ]; then
    echo ""
    echo "❌ Relative parent imports found — use @/ instead of ../:"
    echo "$VIOLATIONS"
    echo ""
    echo "Fix: change 'from \"../foo\"' to 'from \"@/foo\"'"
    exit 1
  fi
fi

if ! bun run check:cycles --no-spinner 2>/dev/null; then
  echo ""
  echo "❌ Circular dependencies detected — run 'bun run check:cycles' to see them."
  echo "Fix the cycle before committing."
  exit 1
fi

if ! node scripts/check-layer-boundaries.js 2>/dev/null; then
  echo ""
  echo "❌ Layer boundary violation — run 'bun run check:boundaries' for details."
  exit 1
fi

if ! node scripts/check-exported-functions.js 2>/dev/null; then
  echo ""
  echo "❌ Exported arrow function found — run 'bun run check:exported-functions' for details."
  exit 1
fi

if ! node scripts/check-filename-casing.js --staged 2>/dev/null; then
  echo ""
  echo "❌ Non-kebab-case filename — run 'bun run check:filename-casing' for details."
  exit 1
fi

if ! node scripts/check-source-file-size.js 2>/dev/null; then
  echo ""
  echo "❌ Source file size limit failed — run 'bun run check:file-size' for details."
  exit 1
fi
if ! node scripts/check-module-ownership.js 2>/dev/null; then
  echo ""
  echo "❌ Module ownership failed — run 'bun run check:module-ownership' for details."
  exit 1
fi

if ! node scripts/check-skill-frontmatter.js --staged; then
  echo ""
  echo "❌ Invalid skill metadata — run 'bun run check:skill-frontmatter' for details."
  exit 1
fi

if git diff --cached --name-only | grep -qE '\.(ts|tsx|js|jsx|json)$' 2>/dev/null; then
  bunx lint-staged
fi

bun run typecheck
